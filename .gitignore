# Build output (generated by Eclipse and by build.bat / build.sh)
/bin/
/jar/
/plugins/*/bin/
/plugins/*/jar/
*.class

# Local test classes in the default package be.stef (not part of Arcana)
/src/be/stef/*.java

# Eclipse workspace metadata (the .project, .classpath and .settings/ files of each project ARE committed)
.metadata/
.recommenders/
*.launch

# JVM crash logs
hs_err_pid*
replay_pid*

# Temporary and OS files
*.tmp
*.bak
*.log
*~
Thumbs.db
desktop.ini
.DS_Store